<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="SettingsPageAnimations">
        <item name="android:windowEnterAnimation">@anim/settings_enter</item>
        <item name="android:windowExitAnimation">@anim/settings_exit</item>
    </style>
    <style name="Theme.Falai" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="colorAccent">@color/action_green</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="alertDialogTheme">@style/Theme.Falai.Dialog</item>
    </style>
    <style name="Theme.Falai.Dialog" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:colorBackground">@color/card</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="colorAccent">@color/action_green</item>
    </style>
</resources>
